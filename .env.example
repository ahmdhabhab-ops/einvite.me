# Runtime environment variables for server.js (set these in Dokploy's
# "Environment" tab for the app). Both are optional — if unset, server.js
# falls back to the same publishable Supabase URL/key already hardcoded in
# src/App.jsx and middleware.js, so the app works even without them.
#
# The frontend bundle (src/App.jsx) does NOT read these — its Supabase
# URL/key are compiled in as literals. Change those in src/App.jsx directly
# if you ever rotate the publishable key, then redeploy.

SUPABASE_URL=https://tahbjwbmigoodfrfjpri.supabase.co
SUPABASE_ANON_KEY=sb_publishable_85PWR75Vq5WcSWvgos6pmg_4JwG0_iM

# Port the Node server listens on inside the container (Dokploy maps this
# through Traefik automatically — leave at 3000 unless you changed the
# Dockerfile's EXPOSE/CMD).
PORT=3000
